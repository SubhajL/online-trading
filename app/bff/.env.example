# Server Configuration
NODE_ENV=development
PORT=3001

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Token Expiration (without "Remember Me")
# - Access token: short-lived, used for API requests
# - Refresh token: longer-lived, used to get new access tokens
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# JWT Token Expiration (with "Remember Me" checked)
# - Extended expiry for persistent sessions across browser restarts
# - Production: use longer values for better UX
# - Testing TC1.4: use short values (1m/5m) to observe token refresh
JWT_REMEMBER_EXPIRATION=24h
JWT_REMEMBER_REFRESH_EXPIRATION=30d

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_platform
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=trading
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000

# Engine Connection
ENGINE_HOST=localhost
ENGINE_PORT=6379
ENGINE_TYPE=redis # redis or tcp

# Router Connection
ROUTER_URL=http://localhost:8080
ROUTER_TIMEOUT=30000

# WebSocket Configuration
WS_CORS_ORIGIN=http://localhost:3000
WS_NAMESPACE=/trading

# Redis Configuration (if using Redis for engine connection)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json