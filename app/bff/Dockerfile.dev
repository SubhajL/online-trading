# Development Dockerfile for BFF service
FROM node:20-alpine

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Install pnpm (v9 required for lockfileVersion 9.0)
RUN npm install -g pnpm@9

# Set working directory
WORKDIR /app

# Copy workspace configuration from root context
COPY pnpm-workspace.yaml ./
COPY package.json ./package.json.root

# Copy BFF-specific package files
COPY app/bff/package.json app/bff/pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install

# Expose port (aligned with .env BFF_PORT)
EXPOSE 8002

# Use the start:dev command for hot-reloading
CMD ["pnpm", "run", "start:dev"]