# Router Configuration
PORT=8001
LOG_LEVEL=info
RATE_LIMIT=100
MAX_CONNECTIONS=50

# Testnet Mode (true/false)
# Default: true (for safety, defaults to testnet)
TESTNET=true

# Binance Spot Configuration
BINANCE_SPOT_API_KEY=your_spot_api_key
BINANCE_SPOT_SECRET_KEY=your_spot_secret_key
# Optional: Override base URL (defaults based on TESTNET)
# BINANCE_SPOT_BASE_URL=https://testnet.binance.vision

# Binance Futures Configuration
# If not set, falls back to BINANCE_SPOT_* values
BINANCE_FUTURES_API_KEY=your_futures_api_key
BINANCE_FUTURES_SECRET_KEY=your_futures_secret_key
# Optional: Override base URL (defaults based on TESTNET)
# BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8002

# Timeout Configuration (seconds)
READ_TIMEOUT=30
WRITE_TIMEOUT=30
IDLE_TIMEOUT=60

# Legacy Support (deprecated, use BINANCE_SPOT_* instead)
# API_KEY=your_api_key
# API_SECRET=your_secret_key
