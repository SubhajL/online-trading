# Development Dockerfile for Go order router
FROM golang:1.22-alpine

# Install necessary packages including air for hot reload
RUN apk add --no-cache git ca-certificates tzdata curl

# Install air for hot reload
RUN go install github.com/cosmtrek/air@v1.52.0

# Set working directory
WORKDIR /app

# Copy go mod files first for caching
COPY app/router/go.mod app/router/go.sum ./

# Download dependencies
RUN go mod download

# Copy source code will be mounted as volume in dev

# Expose port
EXPOSE 8080

# Use air for hot reload in development
CMD ["air", "-c", ".air.toml"]
