# BFF API Configuration
# These are build-time variables - set before `next build`
# Development: http://localhost:3001/api
# Production: https://your-bff-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# WebSocket URL is the base host; UI appends /trading and /alerts namespaces
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Environment
NEXT_PUBLIC_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=true
NEXT_PUBLIC_UI_REVAMP=0

# Chart Configuration
NEXT_PUBLIC_DEFAULT_SYMBOL=BTCUSDT
NEXT_PUBLIC_DEFAULT_TIMEFRAME=15m
